# =============================================================================
# MVUTO REAL ESTATE LTD — Environment template
# Copy to .env.local for local dev. Set the same keys in Vercel for production.
# Create a NEW Supabase project for Mvuto (do not reuse Inuka Afrika’s project).
# =============================================================================

# --- Site ---
NEXT_PUBLIC_SITE_URL=https://mvuto.co.ke

# --- Admin URL (optional secret path — not linked on the public site) ---
# ADMIN_PATH=/mvuto-manage
# NEXT_PUBLIC_ADMIN_PATH=/mvuto-manage

# --- Supabase (Dashboard → Project Settings → API) ---
# Set BOTH public (client/build) and server names on Vercel for reliable API routes.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-publishable-or-anon-key
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-publishable-or-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-secret-or-service-role-key
